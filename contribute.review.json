{"version":3,"kind":"Article","sha256":"cbe32cb76d70830cbe98d551ac921ec2dffcd51cbdabc508de9fd735b46b1da0","slug":"contribute.review","location":"/contribute/review.md","dependencies":[],"frontmatter":{"title":"Reviewing Existing NeurodeskEDU Resources","description":"Neurodesk is a community-driven, open-source platform for reproducible neuroimaging. In NeurodeskEDU, community members contribute tutorials, and example notebooks pull requests. This policy ensures that the review of those contributions is impartial, transparent, and free from conflicts of interest.\n","github":"https://github.com/neurodesk/neurodeskedu/blob/main/books/contribute/review.md","authors":[{"nameParsed":{"literal":"Michèle Masson-Trottier","given":"Michèle","family":"Masson-Trottier"},"name":"Michèle Masson-Trottier","id":"contributors-review-generated-uid-0"}],"downloads":[{"title":"Download source","url":"/edu/_sources/contribute/review.md","filename":"review.md","internal":true,"static":false}],"edit_url":"https://github.com/neurodesk/neurodeskedu/edit/main/books/contribute/review.md","execute":{"skip":true},"numbering":{"title":{"offset":1}},"source_url":"https://github.com/neurodesk/neurodeskedu/blob/main/books/contribute/review.md/blob/main/books/_build/myst-source/contribute/review.md","exports":[{"format":"md","filename":"review.md","url":"/edu/build/review-f020d23a8c379b518b2006e3439c18f3.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"Reviewing for NeurodeskEDU","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"eTxKuAJuNw"}],"identifier":"reviewing-for-neurodeskedu","label":"Reviewing for NeurodeskEDU","html_id":"reviewing-for-neurodeskedu","implicit":true,"key":"w7LYjZwsB9"},{"type":"paragraph","position":{"start":{"line":29,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"Thank you for agreeing to review for ","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"E69b3WQLlV"},{"type":"link","url":"https://neurodesk.org/edu","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"NeurodeskEDU","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"RPoLjSB1PP"}],"urlSource":"https://neurodesk.org/edu","key":"MEpFVp4Shx"},{"type":"text","value":". We’re delighted to have your help. This document outlines our review guidelines and helps you understand what we look for when accepting a tutorial or example notebook into the NeurodeskEDU repository. Our review process takes place publicly via GitHub pull requests on the ","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"Dqv0mlXpud"},{"type":"link","url":"https://github.com/neurodesk/neurodeskedu","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"neurodeskedu","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"M1KzkvdPXS"}],"urlSource":"https://github.com/neurodesk/neurodeskedu","error":true,"key":"r2HQVxeoO0"},{"type":"text","value":" repository.\nWe like to think of NeurodeskEDU as a contributor-friendly resource. If the submitting author has followed best practices (clear instructions, working code, and proper attribution), then their review should be quick. For submissions that don’t quite meet the bar, please try to give clear, constructive feedback on how the author can improve. A key goal of NeurodeskEDU is to raise the quality of neuroimaging education resources, and you (the experienced reviewer) are well placed to help with that.","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"Qe4rSeNYNN"}],"key":"XYOSJXFcrk"},{"type":"heading","depth":3,"position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"Guiding Principles","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"gSnyV6PFXp"}],"identifier":"guiding-principles","label":"Guiding Principles","html_id":"guiding-principles","implicit":true,"key":"QOkBPu8H0h"},{"type":"paragraph","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"A NeurodeskEDU review involves checking tutorial and notebook submissions against a set of criteria covering content quality, reproducibility, and clarity. Reviews should be objective, not subjective; based on the materials in the submission as perceived without distortion by personal feelings, prejudices, or interpretations.","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"lWlPO7qwLa"}],"key":"feB3UhatRR"},{"type":"paragraph","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"Reviewers should:","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"guGC3hNQTW"}],"key":"rgevWjs8Ln"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":37,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Be respectful and constructive in all feedback.","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"ige03h0IwA"}],"key":"YzXJYoMjsz"}],"key":"fVQrorimZb"},{"type":"listItem","spread":true,"position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Focus on whether the submission meets the review criteria below.","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"dqnyK983G5"}],"key":"CG3HNjTxuR"}],"key":"pjniDIQFmp"},{"type":"listItem","spread":true,"position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"File suggestions or issues directly in the pull request thread.","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"tpN9Wzk5Y3"}],"key":"gefoj2jwAa"}],"key":"kd1rGwZ0Dz"},{"type":"listItem","spread":true,"position":{"start":{"line":40,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"When you have completed your review, leave a comment in the pull request saying so.","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"FEapzceArr"}],"key":"ddD9Bosm0v"}],"key":"hFHylaX5C4"}],"key":"RLY3EaAgk8"},{"type":"thematicBreak","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"Qi36z7VZ2H"},{"type":"heading","depth":3,"position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"Time Expectations","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"rlTO40SGT7"}],"identifier":"time-expectations","label":"Time Expectations","html_id":"time-expectations","implicit":true,"key":"x7RDMqX7ZR"},{"type":"paragraph","position":{"start":{"line":46,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"We ask reviewers to complete their reviews within 2 weeks. We generally ask the same commitment from contributors: they should respond to feedback within 1 week and complete requested changes within 2 weeks, unless otherwise negotiated with the maintainers (for example, if the changes requested are particularly substantial).\nIf a contributor becomes unresponsive, the maintainers will follow up to keep the review moving forward. If you need more time to complete your review, please let us know, we’d rather have a thorough late review than a rushed one.","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"RhjPGygM8p"}],"key":"SfPG6aJcC6"},{"type":"heading","depth":3,"position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"text","value":"Conflict of Interest Policy","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"j22sWTBiFC"}],"identifier":"conflict-of-interest-policy","label":"Conflict of Interest Policy","html_id":"conflict-of-interest-policy","implicit":true,"key":"ICsqEOw9li"},{"type":"paragraph","position":{"start":{"line":51,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"The definition of a conflict of interest (COI) in peer review is a circumstance that makes you “unable to make an impartial scientific judgment or evaluation” (","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"gWD0R6B3tP"},{"type":"link","url":"https://www.pnas.org/author-center/editorial-and-journal-policies#competing-interest","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"PNAS COI Policy","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"RGr6sfvyqO"}],"urlSource":"https://www.pnas.org/author-center/editorial-and-journal-policies#competing-interest","key":"LCrAkOcN1R"},{"type":"text","value":"). NeurodeskEDU is concerned with avoiding any actual conflicts of interest, and being sufficiently transparent that we avoid the appearance of conflicts of interest as well.\nAs a reviewer (or maintainers), COIs are your present or previous association with any authors of a submission:","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"MxrnfSpJBA"}],"key":"ibP0hfcH5W"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":54,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Recent collaborators (past four years) in funded research or work that is published.","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"IlC00ebRuW"}],"key":"Rx0IJicId7"}],"key":"exXRu9N6cm"},{"type":"listItem","spread":true,"position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Family members, business partners, and thesis student/advisor or mentor (lifetime).","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"WQvFaFzD3Q"}],"key":"FJFNeo4Vym"}],"key":"i5pNIeoiEF"},{"type":"listItem","spread":true,"position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Same organisation (past year) — for example, being employed at the same institution as the contributor.","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"O90kFKyYpe"}],"key":"rv83glhtTX"}],"key":"l41E5k1XL7"},{"type":"listItem","spread":true,"position":{"start":{"line":57,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Financial interests in software, tools, or services featured in the contribution.","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"fdcDkjBGVC"}],"key":"AgQnIrh3rS"}],"key":"WzX2wX0nsp"}],"key":"N4prHvfrvl"},{"type":"paragraph","position":{"start":{"line":59,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"text","value":"If you have a conflict of interest with a submission, you should disclose the specific reason to the editor handling the pull request. This may lead to you not being able to review the submission, but some conflicts may be recorded and then waived, and if you think you are able to make an impartial assessment of the work, you should request that the conflict be waived.\nExamples of potentially waivable conflicts:","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"BlbAqNMjeT"}],"key":"Odv2GOr07q"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":62,"column":1},"end":{"line":65,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"You and the contributor were both co-authors on a large consortium paper but did not actually collaborate directly.","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"pjlqBRfsn4"}],"key":"fWQGxBWpVD"}],"key":"zZfsJ7ujCO"},{"type":"listItem","spread":true,"position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"You and the contributor worked together six years ago, but a paper from that collaboration was published two years ago due to publishing delays.","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"pTEhhYzr8a"}],"key":"I0SwAy1F2X"}],"key":"qb322SFT8w"},{"type":"listItem","spread":true,"position":{"start":{"line":64,"column":1},"end":{"line":65,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"You and the contributor are both employed by the same very large organisation but in different units without any knowledge of each other.","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"TMelBRQLoy"}],"key":"MAb0osqudl"}],"key":"vcANC46HVA"}],"key":"Cpzhp8v8a4"},{"type":"paragraph","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"text","value":"Declaring actual, perceived, and potential conflicts of interest is required under professional ethics. If in doubt, disclose and let the editor decide.","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"Gl5OtkNqig"}],"key":"md8W8gwXWm"},{"type":"heading","depth":3,"position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"children":[{"type":"text","value":"Review Criteria","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"KSP3ZszthQ"}],"identifier":"review-criteria","label":"Review Criteria","html_id":"review-criteria","implicit":true,"key":"Yk6QrkC8vv"},{"type":"paragraph","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"text","value":"When reviewing a tutorial or example notebook submission, please check ","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"aCYnAhhGRf"},{"type":"link","url":"https://github.com/neurodesk/neurodeskedu-reviews/blob/master/.buffy/templates/reviewer_checklist.md","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"text","value":"the following","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"WuMgAzHhOB"}],"urlSource":"https://github.com/neurodesk/neurodeskedu-reviews/blob/master/.buffy/templates/reviewer_checklist.md","data":{"kind":"file","org":"neurodesk","repo":"neurodeskedu-reviews","reference":"master","file":".buffy/templates/reviewer_checklist.md","raw":"https://raw.githubusercontent.com/neurodesk/neurodeskedu-reviews/master/.buffy/templates/reviewer_checklist.md"},"internal":false,"protocol":"github","key":"jPIaSinpSi"},{"type":"text","value":".","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"g1OdkSO8Kc"}],"key":"EnjpYo20f9"},{"type":"thematicBreak","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"rYieAVjuRs"},{"type":"heading","depth":3,"position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"children":[{"type":"text","value":"What Happens After Review?","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"key":"phDG34uIKE"}],"identifier":"what-happens-after-review","label":"What Happens After Review?","html_id":"what-happens-after-review","implicit":true,"key":"gkXLDBdXvV"},{"type":"paragraph","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"children":[{"type":"text","value":"Once all reviewers are satisfied that the submission meets the criteria above, the maintainers will change the status of the revision badge on the ","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"NGz0QXQlvJ"},{"type":"link","url":"https://neurodesk.org/edu","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"children":[{"type":"text","value":"NeurodeskEDU site","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"AxLC1EyhH0"}],"urlSource":"https://neurodesk.org/edu","key":"tNnI4a7puz"},{"type":"text","value":" and reviewers’ Github handle will appear in the revision badge. Contributors are acknowledged on the ","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"iTwaI1VSfG"},{"type":"link","url":"https://neurodesk.org/developers/contributors/","children":[{"type":"text","value":"Contributors page","key":"GeANz6WCiZ"}],"urlSource":"https://neurodesk.org/developers/contributors/","key":"zfKaT3l9cp"},{"type":"text","value":". To be listed, include your name and a short description in your pull request using ","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"kmqSVQBqEf"},{"type":"link","url":"https://github.com/neurodesk/neurodesk.github.io/blob/main/.github/content-templates/contributor-format.md","children":[{"type":"text","value":"this format","key":"FyfQLKUtOw"}],"urlSource":"https://github.com/neurodesk/neurodesk.github.io/blob/main/.github/content-templates/contributor-format.md","data":{"kind":"file","org":"neurodesk","repo":"neurodesk.github.io","reference":"main","file":".github/content-templates/contributor-format.md","raw":"https://raw.githubusercontent.com/neurodesk/neurodesk.g