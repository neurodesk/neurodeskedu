s on the current desktop","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"Nz5ebEfD0i","urlSource":"https://raw.githubusercontent.com/neurodesk/media/neurodesk-shared-gui-controls-2026-10-20/screenshots/neurodesk/launch-fmriprep-guide.png"},{"type":"paragraph","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"text","value":"The application entry opens a terminal with fMRIPrep loaded. Check the version before entering the analysis command:","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"kysNjD0Nbk"}],"key":"yH7OXWhIGW"},{"type":"code","lang":"bash","value":"fmriprep --version\nml list","position":{"start":{"line":72,"column":1},"end":{"line":75,"column":1}},"key":"nrOHMYoz17"},{"type":"paragraph","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"text","value":"You can also load a container in an existing terminal with ","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"u8CRVawMWW"},{"type":"inlineCode","value":"ml fmriprep/<version>","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"GYb2OJS2oW"},{"type":"text","value":". The command examples below were checked against the installed fMRIPrep command help; running a complete analysis also requires your BIDS data and FreeSurfer license.","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"FTrlcD9h7q"}],"key":"O55xdMwTOF"},{"type":"heading","depth":3,"position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"text","value":"Setting up fmriprep command","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"nPHbGvIsHo"}],"identifier":"setting-up-fmriprep-command","label":"Setting up fmriprep command","html_id":"setting-up-fmriprep-command","implicit":true,"key":"oMHhOT1hoJ"},{"type":"paragraph","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"text","value":"You can now enter your fmriprep command straight into the command line in the newly opened terminal. Here is a quick guide to the command I have used with the options I have found most useful. Note that fMRIPrep requests the path to the freesurfer license file, which should be somewhere in your system for neurodesk to read - e.g. in ‘neurodesktop-storage’.","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"R3uCfsT6o1"}],"key":"Q5TUNtOUeg"},{"type":"paragraph","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"children":[{"type":"text","value":"Replace the example paths with your BIDS dataset, output directory, work directory and FreeSurfer license. Keep the work and output directories separate from the input data. This example uses six processes and a 10,000 MB memory budget; match these to your allocation.","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"key":"Fqz3ip8wjx"}],"key":"nhDAeNWgoZ"},{"type":"code","lang":"bash","value":"export ITK_GLOBAL_DEFAULT_NUMBER_OF_THREADS=6\n\nfmriprep /path/to/bids \\\n  /path/to/derivatives/fmriprep \\\n  participant \\\n  --fs-license-file /path/to/freesurfer.txt \\\n  --output-spaces T1w MNI152NLin2009cAsym fsaverage fsnative \\\n  --participant-label 01 \\\n  --nprocs 6 --mem 10000 \\\n  -w /path/to/work/fmriprep \\\n  -v","position":{"start":{"line":85,"column":1},"end":{"line":97,"column":1}},"key":"uuT5OLbd7B"},{"type":"paragraph","position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"children":[{"type":"text","value":"A continuation backslash must be the last character on its line. Leave BIDS validation enabled for the first run. See the ","position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"key":"zFLPHU9MNQ"},{"type":"link","url":"https://fmriprep.org/en/stable/usage.html","position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"children":[{"type":"text","value":"fMRIPrep command reference","position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"key":"tISI31SXd1"}],"urlSource":"https://fmriprep.org/en/stable/usage.html","key":"V9SaxOUfSv"},{"type":"text","value":" for options.","position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"key":"WzLNFAfSGR"}],"key":"MjEeBCOeso"},{"type":"paragraph","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"children":[{"type":"text","value":"Then hit return and fMRIPrep should now be merrily working away on your data :)","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"key":"RjueoWIwV1"}],"key":"U2tEoaGfAI"},{"type":"thematicBreak","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"key":"ErtuooawaO"},{"type":"heading","depth":3,"position":{"start":{"line":106,"column":1},"end":{"line":106,"column":1}},"children":[{"type":"text","value":"Some common pitfalls I have learned from my mistakes (and sometimes from others)","position":{"start":{"line":106,"column":1},"end":{"line":106,"column":1}},"key":"piDLgbpap5"}],"identifier":"some-common-pitfalls-i-have-learned-from-my-mistakes-and-sometimes-from-others","label":"Some common pitfalls I have learned from my mistakes (and sometimes from others)","html_id":"some-common-pitfalls-i-have-learned-from-my-mistakes-and-sometimes-from-others","implicit":true,"key":"iPpTAi1LsW"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":108,"column":1},"end":{"line":115,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":108,"column":1},"end":{"line":109,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"children":[{"type":"text","value":"If fmriprep hangs it could well be that you are out of disk space. Sometimes this is because fmriprep created a work directory i