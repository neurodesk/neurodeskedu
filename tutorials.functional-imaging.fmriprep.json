ow you’re in Neurodesk, use the menus to first open the neurodesk options","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"aqSIDDSjQ4"}],"key":"k34PwP9Ybs"},{"type":"paragraph","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"image","url":"/edu/build/neurodesk_menu-a39290af994ace038e4383812e41bab5.png","alt":"neurodesk_menu","title":"neurodesk_menu","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"qPm5i2aCKC","urlSource":"/static/tutorials/functional_imaging/fmriprep/neurodesk_menu.png"},{"type":"text","value":" ","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"LbyydokPZD"},{"type":"comment","value":" ![filename without extension](/static/tutorials/functional_imaging/subfolder_name/filename.png '[filename without extension')  ","key":"x79uZl96i1"}],"key":"uIDl9a4XnW"},{"type":"paragraph","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"children":[{"type":"text","value":"and then select fMRIPrep. Note that the latest version will be the lowest on the dropdown list:","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"bUn3Qiy7wI"}],"key":"f2ZzYz2NEz"},{"type":"paragraph","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"children":[{"type":"image","url":"/edu/build/open_fmriprep-432867a812f4c27e89420e821fcd3ee4.png","alt":"open_fmriprep","title":"open_fmriprep","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"key":"yF8Dy0bAil","urlSource":"/static/tutorials/functional_imaging/fmriprep/open_fmriprep.png"},{"type":"text","value":" ","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"key":"xXHFvEycc2"},{"type":"comment","value":" ![filename without extension](/static/tutorials/functional_imaging/subfolder_name/filename.png '[filename without extension')  ","key":"cGWOu1xeh8"}],"key":"OHvcPXfguT"},{"type":"paragraph","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"children":[{"type":"text","value":"This will open a terminal window where fMRIPrep is ready and waiting at your fingertips - woohoo!","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"BxKESVtgDt"}],"key":"bnSPSCwCSG"},{"type":"paragraph","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"children":[{"type":"image","url":"/edu/build/fmriprep_bash-22f202780cd628f3f34f698607a41fa4.png","alt":"fmriprep_bash","title":"fmriprep_bash","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"DLwJgZVRwd","urlSource":"/static/tutorials/functional_imaging/fmriprep/fmriprep_bash.png"},{"type":"text","value":" ","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"mAKw8gvwmC"},{"type":"comment","value":" ![filename without extension](/static/tutorials/functional_imaging/subfolder_name/filename.png '[filename without extension')  ","key":"IwPKFOsrqn"}],"key":"k5sgjYIIFR"},{"type":"heading","depth":3,"position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"text","value":"Setting up fmriprep command","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"I9FvoUrdNl"}],"identifier":"setting-up-fmriprep-command","label":"Setting up fmriprep command","html_id":"setting-up-fmriprep-command","implicit":true,"key":"zStiQA4Y3x"},{"type":"paragraph","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"children":[{"type":"text","value":"You can now enter your fmriprep command straight into the command line in the newly opened terminal. Here is a quick guide to the command I have used with the options I have found most useful. Note that fMRIPrep requests the path to the freesurfer license file, which should be somewhere in your system for neurodesk to read - e.g. in ‘neurodesktop-storage’.","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"key":"v8LjDjwLUq"}],"key":"QLvwnaYOza"},{"type":"code","lang":"bash","value":"\nexport ITK_GLOBAL_DEFAULT_NUMBER_OF_THREADS=6 # specify the number of threads you want to use\n\nfmriprep /path/to/your/data \\ # this is the top level of your data folder\n         /path/to/your/data/derivatives \\ # where you want fmriprep output to be saved\n         participant \\ # this tells fmriprep to analyse at the participant level\n         --fs-license-file /path/to/your/freesurfer.txt \\ # where the freesurfer license file is\n         --output-spaces T1w MNI152NLin2009cAsym fsaverage fsnative \\ \n         --participant-label 01 \\ # put what ever participant labels you want to analyse\n         --nprocs 6 --mem 10000 \\ # fmriprep can be greedy on the hpc, make sure it is not\n         --skip_bids_validation \\ # its normally fine to skip this but do make sure your data are BIDS enough\n         -v # be verbal fmriprep, tell me what you are doing","position":{"start":{"line":85,"column":1},"end":{"line":98,"column":1}},"key":"AGPvewFFZe"},{"type":"paragraph","position":{"start":{"line":101,"column":1},"end":{"line":101,"column":1}},"children":[{"type":"text","value":"Then hit return and fMRIPrep should now be merrily working away on your data :)","position":{"start":{"line":101,"column":1},"end":{"line":101,"column":1}},"key":"c7GW3ot9IS"}],"key":"FOXXHBnpmB"},{"type":"thematicBreak","position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"key":"bBeqZWC7jF"},{"type":"heading","depth":3,"position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"children":[{"type":"text","value":"Some common pitfalls I have learned from my mistakes (and sometimes from others)","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"key":"TycpStnywi"}],"identifier":"some-common-pitfalls-i-have-learned-from-my-mistakes-and-sometimes-from-others","label":"Some common pitfalls I have learned from my mistakes (and sometimes from others)","html_id":"some-common-pitfalls-i-have-learned-from-my-mistakes-and-sometimes-from-others","implicit":true,"key":"XSycot2jNj"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":107,"column":1},"end":{"line":114,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":107,"column":1},"end":{"line":108,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":107,"column":1},"end":{"line":107,"column":1}},"children":[{"type":"text","value":"If fmriprep hangs it could well be that you are out of disk space. Sometimes this is because fmriprep created a work directory in your home folder which is often limited on the HPC. Make sure fmriprep knows to use a work drectory in your scratch. you can specify this in the fmriprep command by using -w /path/to/the/work/directory/you/made","position":{"start":{"line":107,"column":1},"end":{"line":107,"column":1}},"key":"FTlwiU4Skh"}],"key":"RWrNJuhbNJ"}],"key":"nKvvk3DFnx"},{"type":"listItem","spread":true,"position":{"start":{"line":109,"column":1},"end":{"line":110,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":109,"column":1},"end":{"line":109,"column":1}},"children":[{"type":"text","value":"I learned the following from TomCat (@thomshaw92) - fMRIPrep can get confused between subjects when run in parallel. Parallelise with caution.","position":{"start":{"line":109,"column":1},"end":{"line":109,"column":1}},"key":"All2Vq3G96"}],"key":"C96UVR6Fm5"}],"key":"FVeaGZrBDI"},{"type":"listItem","spread":true,"position":{"start":{"line":111,"column":1},"end":{"line":112,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":111,"column":1},"end":{"line":111,"column":1}},"children":[{"type":"text","value":"If running on a HPC, make sure to set the processor and memory limits, if not your job will get killed because it hogs all the resources.","position":{"start":{"line":111,"column":1},"end":{"line":111,"column":1}},"key":"ErBFlnY9Ri"}],"key":"mrD5EMluaS"}],"key":"lb0edxOTep"},{"type":"listItem","spread":true,"position":{"start":{"line":113,"column":1},"end":{"line":114,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":113,"column":1},"end":{"line":114,"column":1}},"children":[{"type":"text","value":"Viewing fMRIprep HTML Outputs: Do not view these files in a browser within Neurodesktop using the RDP protocol. The HTML animations break RDP compression.\nRecommended Alternatives:","position":{"start":{"line":113,"column":1},"end":{"line":113,"column":1}},"key":"VWEZFOZdpx"}],"key":"EecAWKjM1t"}],"key":"WJeadtq3vN"}],"key":"kYHsKvuUg6"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":115,"column":1},"end":{"line":116,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":115,"column":1},"end":{"line":115,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"JupyterLab (Best Performance): Open the reports directly using the JupyterLab file browser.","position":{"start":{"line":115,"column":1},"end":{"line":115,"column":1}},"key":"VRvcrherSX"}],"key":"KpaP6aKCFS"}],"key":"wuyhia6F1Z"},{"type":"listItem","spread":true,"position":{"start":{"line":116,"column":1},"end":{"line":116,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"VNC Protocol: If you prefer a full Linux desktop environment, connect via VNC instead of RDP.","position":{"start":{"line":116,"column":1},"end":{"line":116,"column":1}},"key":"kI5RrCxXy1"}],"key":"T57I6li3OR"}],"key":"GXk0YJUjRH"}],"key":"v9HECr34V1"}],"key":"bFpen2EUFQ"}],"key":"uTxdjfNkFs"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Connectome Workbench","url":"/tutorials/functional-imaging/connectomeworkbench","group":"Neurodesk"},"next":{"title":"Using mriqc with neurodesk on HPC","url":"/tutorials/functional-imaging/mriqc","group":"Neurodesk"}}},"domain":"http://localhost:3000"}