 montage. Lets create one using standard values for the electrodes we have:","position":{"start":{"line":147,"column":1},"end":{"line":147,"column":1}},"key":"JfB7njCCcH"}],"key":"IkHtkgaN8m"},{"type":"code","lang":"python","value":"# Create montage\nmontage = {'Iz':  [0, -110, -40],\n            'Oz': [0, -105, -15],\n            'POz': [0,   -100, 15],\n            'O1': [-40, -106, -15],\n            'O2':  [40, -106, -15],\n }\n\nmontageuse = mne.channels.make_dig_montage(ch_pos=montage, lpa=[-82.5, -19.2, -46], nasion=[0, 83.2, -38.3], rpa=[82.2, -19.2, -46]) # based on mne help file on setting 10-20 montage","position":{"start":{"line":148,"column":1},"end":{"line":158,"column":1}},"key":"Mik3YRMyuq"},{"type":"paragraph","position":{"start":{"line":160,"column":1},"end":{"line":160,"column":1}},"children":[{"type":"text","value":"Next, lets visualise the data.","position":{"start":{"line":160,"column":1},"end":{"line":160,"column":1}},"key":"qyBYxl0y2T"}],"key":"C710SV0JAX"},{"type":"code","lang":"python","value":"raw.plot()","position":{"start":{"line":161,"column":1},"end":{"line":163,"column":1}},"key":"PHnnR7uEEe"},{"type":"paragraph","position":{"start":{"line":165,"column":1},"end":{"line":165,"column":1}},"children":[{"type":"text","value":"This should open an interactive window in which you can scroll through the data. See the MNE documentation for help on how to customise this plot.","position":{"start":{"line":165,"column":1},"end":{"line":165,"column":1}},"key":"rXcaVstVh4"}],"key":"DdJs9qUoIj"},{"type":"image","url":"/edu/build/raw-eeg-52d5e9c5b8d4931abf2b3425c1a37e1e.png","alt":"Interactive raw EEG traces","position":{"start":{"line":167,"column":1},"end":{"line":167,"column":1}},"key":"t7OB6hv414","urlSource":"/static/tutorials/electrophysiology/eeg_mne-python/raw-eeg.png"},{"type":"paragraph","position":{"start":{"line":169,"column":1},"end":{"line":169,"column":1}},"children":[{"type":"text","value":"If, upon visual inspection, you decide to exclude one of the channels, you can specify this in ","position":{"start":{"line":169,"column":1},"end":{"line":169,"column":1}},"key":"fEglU1AArA"},{"type":"inlineCode","value":"raw.info['bads']","position":{"start":{"line":169,"column":1},"end":{"line":169,"column":1}},"key":"qFGfrwAoTL"},{"type":"text","value":" now. For example:","position":{"start":{"line":169,"column":1},"end":{"line":169,"column":1}},"key":"bKsGbuXFsJ"}],"key":"mgGW2JItYq"},{"type":"code","lang":"python","value":"raw.info['bads'] = ['POz']","position":{"start":{"line":170,"column":1},"end":{"line":172,"column":1}},"key":"J8LEQaGdlX"},{"type":"paragraph","position":{"start":{"line":174,"column":1},"end":{"line":174,"column":1}},"children":[{"type":"text","value":"Next, we’ll extract our events. The trigger channel in this file is incorrectly scaled, so we’ll correct that before we extract our events:","position":{"start":{"line":174,"column":1},"end":{"line":174,"column":1}},"key":"ukv6tDSxpk"}],"key":"xgTkkXXH4s"},{"type":"code","lang":"python","value":"# Correct trigger scaling\ntrigchan = raw.copy()\ntrigchan = trigchan.pick('TRIG')\ntrigchan._data = trigchan._data*1000000\n\n# Extract events\nevents = mne.find_events(trigchan, stim_channel='TRIG', consecutive=True, initial_event=True, verbose=True)\nprint('Found %s events, first five:' % len(events))\nprint(events[:5])\n\n# Plot events\nmne.viz.plot_events(events, raw.info['sfreq'], raw.first_samp)","position":{"start":{"line":175,"column":1},"end":{"line":188,"column":1}},"key":"GvvSDKLnit"},{"type":"image","url":"/edu/build/events-d437b961a47bb94d1d9397725fadc69a.png","alt":"Events extracted from the trigger channel","position":{"start":{"line":190,"column":1},"end":{"line":190,"column":1}},"key":"QR49xy8Q8r","urlSource":"/static/tutorials/electrophysiology/eeg_mne-python/events.png"},{"type":"paragraph","position":{"start":{"line":192,"column":1},"end":{"line":192,"column":1}},"children":[{"type":"text","value":"Now that we’ve extracted our events, we can extract our EEG channels and do some simple pre-processing:","position":{"start":{"line":192,"column":1},"end":{"line":192,"column":1}},"key":"i74ry4Ddac"}],"key":"FZ2qlQ5lah"},{"type":"code","lang":"python","value":"# select\neeg_data = raw.copy().pick_types(eeg=True, exclude=['TRIG'])\n\n# Set montage\neeg_data.info.set_montage(montageuse)\n\n# Interpolate\neeg_data_interp = eeg_data.copy().interpolate_bads(reset_bads=True) \n\n# Filter Data\neeg_data_interp.filter(l_freq=1, h_freq=45, h_trans_bandwidth=0.1)","position":{"start":{"line":193,"column":1},"end":{"line":205,"column":1}},"key":"IuIFHRUq3X"},{"type":"paragraph","position":{"start":{"line":207,"column":1},"end":{"line":207,"column":1}},"children":[{"type":"text","value":"Let’s visualise our data again now that it’s cleaner:","position":{"start":{"line":207,"column":1},"end":{"line":207,"column":1}},"key":"onUZbyCSYL"}],"key":"jqtQR3Jpqq"},{"type":"code","lang":"python","value":"#plot results again, this time with some events and scaling. \neeg_data_interp.plot(events=events, duration=10.0, scalings=dict(eeg=0.00005), color='k', event_color='r')","position":{"start":{"line":208,"column":1},"end":{"line":211,"column":1}},"key":"gIxsipChaT"},{"type":"image","url":"/edu/build/filtered-eeg-c432ce09bda490f31589d96e1cc45027.png","alt":"Filtered EEG after interpolation","position":{"start":{"line":213,"column":1},"end":{"line":213,"column":1}},"key":"tBJJaBlz7c","urlSource":"/static/tutorials/electrophysiology/eeg_mne-python/filtered-eeg.png"},{"type":"paragraph","position":{"start":{"line":215,"column":1},"end":{"line":215,"column":1}},"children":[{"type":"text","value":"That’s looking good! We can even see hints of the frequency tagging. It’s about time to epoch our data.","position":{"start":{"line":215,"column":1},"end":{"line":215,"column":1}},"key":"UNB959P1jG"}],"key":"deVUuQZRRe"},{"type":"code","lang":"python","value":"# Epoch to events of interest\nevent_id = {'attend 6Hz K': 23, 'attend 7.5Hz K':  27}  \n\n# Extract 15 s epochs relative to events, baseline correct, linear detrend, and reject \n# epochs where eeg amplitude is > 400\nepochs = mne.Epochs(eeg_data_interp, events, event_id=event_id, tmin=0,\n                    tmax=15, baseline=(0, 0), reject=dict(eeg=0.000400), detrend=1)  \n\n# Drop bad trials\nepochs.drop_bad()","position":{"start":{"line":216,"column":1},"end":{"line":227,"column":1}},"key":"TyVxQN0nc1"},{"type":"paragraph","position":{"start":{"line":229,"column":1},"end":{"line":229,"column":1}},"children":[{"type":"text","value":"We can average these epochs to form Event Related Potentials (ERPs):","position":{"start":{"line":229,"column":1},"end":{"line":229,"column":1}},"key":"CQaAEvgDL0"}],"key":"xMlp3d80mH"},{"type":"code","lang":"python","value":"# Average erpochs to form ERPs\nattend6 = epochs['attend 6Hz K'].average()\nattend75 = epochs['attend 7.5Hz K'].average()\n\n# Plot ERPs\nevokeds = dict(attend6=list(epochs['attend 6Hz K'].iter_evoked()),\n               attend75=list(epochs['attend 7.5Hz K'].iter_evoked()))\nmne.viz.plot_compare_evokeds(evokeds, combine='mean')","position":{"start":{"line":230,"column":1},"end":{"line":239,"column":1}},"key":"DneeRgbBdF"},{"type":"image","url":"/edu/build/evoked-responses-b7ae2b1414b770ae594ee2919422fa7d.png","alt":"Evoked responses for both attention conditions","position":{"start":{"line":241,"column":1},"end":{"line":241,"column":1}},"key":"WjYAk740WP","urlSource":"/static/tutorials/electrophysiology/eeg_mne-python/evoked-responses.png"},{"type":"paragraph","position":{"start":{"line":243,"column":1},"end":{"line":243,"column":1}},"children":[{"type":"text","value":"In this plot, we can see that the data are frequency tagged. While these data were collected, the participant was performing an attention task in which two visual stimuli were flickering at 6 Hz and 7.5 Hz respectively. On each trial the participant was cued to monitor one of these two stimuli for brief bursts of motion. From previous research, we expect that the steady-state visual evoked potential (SSVEP) should be larger at the attended frequency than the unattended frequency. Lets check if this is true.","position":{"start":{"line":243,"column":1},"end":{"line":243,"column":1}},"key":"Y3WVeQYmOs"}],"key":"ZJ2WW7JCKN"},{"type":"paragraph","position":{"start":{"line":245,"column":1},"end":{"line":245,"column":1}},"children":[{"type":"text","value":"We’ll begin by exporting our epoched EEG data to a numpy array","position":{"start":{"line":245,"column":1},"end":{"line":245,"column":1}},"key":"QUGBXay1rm"}],"key":"QtPBT2xtYu"},{"type":"code","lang":"python","value":"# Preallocate\nn_samples = attend6.data.shape[1]\nsampling_freq = 1200 # sampling frequency\nepochs_np = np.empty((n_samples, 2) )\n\n# Get data - averaging across EEG channels\nepochs_np[:,0] = attend6.data.mean(axis=0)\nepochs_np[:,1] = attend75.data.mean(axis=0)\n","position":{"start":{"line":247,"column":1},"end":{"line":257,"column":1}},"key":"wVbdSsFBOC"},{"type":"paragraph","position":{"start":{"line":259,"column":1},"end":{"line":259,"column":1}},"children":[{"type":"text","value":"Next, we can use a Fast Fourier Transform (FFT) to transform the data from the time domain to the frequency domain. For this, we’ll need to import the FFT packages from scipy:","position":{"start":{"line":259,"column":1},"end":{"line":259,"column":1}},"key":"NY2uKtnaIq"}],"key":"EkPgzP6xmL"},{"type":"code","lang":"python","value":"from scipy.fft import fft, fftfreq, fftshift\n\n# Get FFT\nfftdat = np.abs(fft(epochs_np, axis=0)) / n_samples\nfreq = fftfreq(n_samples, d=1 / sampling_freq)  # get frequency bins\n","position":{"start":{"line":261,"column":1},"end":{"line":268,"column":1}},"key":"pEgsSxXjcT"},{"type":"paragraph","position":{"start":{"line":270,"column":1},"end":{"line":270,"column":1}},"children":[{"type":"text","value":"Now that we have our frequency transformed data, we can plot our two conditions to assess whether attention altered the SSVEP amplitudes:","position":{"start":{"line":270,"column":1},"end":{"line":270,"column":1}},"key":"g3hGViunYh"}],"key":"PyvJR6FrfT"},{"type":"code","lang":"python","value":"import matplotlib.pyplot as plt\n\nfig,ax = plt.subplots(1, 1)\n\nax.plot(freq, fftdat[:,0], '-', label='attend 6Hz', color=[78 / 255, 185 / 255, 159 / 255])  \nax.plot(freq, fftdat[:,1], '-', label='attend 7.5Hz', color=[236 / 255, 85 / 255, 58 / 255])  \nax.set_xlim(4, 17)\nax.set_ylim(0, 1e-6)\nax.set_title('Frequency Spectrum')\nax.legend()\n\n","position":{"start":{"line":272,"column":1},"end":{"line":285,"column":1}},"key":"ufp3u4myAj"},{"type":"image","url":"/edu/build/frequency-spectrum-adcf4fa61e95c269da3f80d7a05c6be7.png","alt":"Frequency spectrum for both attention conditions","position":{"start":{"line":286,"column":1},"end":{"line":286,"column":1}},"key":"nNU434pamo","urlSource":"/static/tutorials/electrophysiology/eeg_mne-python/frequency-spectrum.png"},{"type":"paragraph","position":{"start":{"line":288,"column":1},"end":{"line":288,"column":1}},"children":[{"type":"text","value":"This plot shows that the SSVEPs were indeed modulated by attention in the direction we would expect! Congratulations! You’ve run your first analysis of EEG data in neurodesktop.","position":{"start":{"line":288,"column":1},"end":{"line":288,"column":1}},"key":"MKunluERU0"}],"key":"gPwVzZvKSf"}],"key":"OUMjB86GAN"}],"key":"qXayP9knL3"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Electrophysiology","url":"/tutorials/electrophysiology/intro","group":"Neurodesk"},"next":{"title":"Analysing M/EEG Data with FieldTrip","url":"/tutorials/electrophysiology/fieldtrip","group":"Neurodesk"}}},"domain":"http://localhost:3000"}