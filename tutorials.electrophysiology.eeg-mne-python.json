conda, you can activate the MNE environment in the terminal:","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"Pc2uVw4M3C"}],"key":"TdRM7qjTZ5"},{"type":"code","lang":"","value":"conda activate mne-0.23.4","position":{"start":{"line":73,"column":1},"end":{"line":75,"column":1}},"key":"Zt02bPyAWf"},{"type":"paragraph","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"text","value":"You should now see “(mne-0.23.4)” ahead of the current line in the terminal.","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"cCfHzZXWGO"}],"key":"U2ueMNDpNX"},{"type":"heading","depth":2,"position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"text","value":"Download sample data","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"mFyQx3qWvS"}],"identifier":"download-sample-data","label":"Download sample data","html_id":"download-sample-data","implicit":true,"key":"UEzNuXkfnP"},{"type":"paragraph","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"text","value":"In the terminal (in which you have activated the MNE environment), input the following code to download some BIDS formatted sample EEG data:","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"lr8aNTnpWY"}],"key":"oaz4G02RAg"},{"type":"blockquote","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"children":[{"type":"text","value":"Remember to update the path to the location you are storing this tutorial!","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"key":"VN0SH8rWBL"}],"key":"F4YPUj2bu3"}],"key":"bamQI2dpcw"},{"type":"code","lang":"","value":"pip install osfclient\nosf -p C689U fetch Data_sample.zip /neurodesktop-storage/EEGDEMO/Data_sample.zip\nunzip Data_sample.zip ","position":{"start":{"line":85,"column":1},"end":{"line":89,"column":1}},"key":"v7K0jqAm0w"},{"type":"paragraph","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"children":[{"type":"text","value":"This is a small dataset with only 5 EEG channels from a single participant. The participant is viewing a frequency tagged display and is cued to attend to dots tagged at one frequency or another (6 Hz, 7.5 Hz) for long, 15 s trials. To read more about the dataset, click ","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"FcEJH94uEW"},{"type":"link","url":"https://osf.io/c689u/","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"children":[{"type":"text","value":"here","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"ePHeSz6NyK"}],"urlSource":"https://osf.io/c689u/","key":"aWP2IAwXbl"}],"key":"a66huE0z5j"},{"type":"heading","depth":2,"position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"children":[{"type":"text","value":"Plotting settings","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"key":"tItH0SbQa1"}],"identifier":"plotting-settings","label":"Plotting settings","html_id":"plotting-settings","implicit":true,"key":"i0x2WJcY1e"},{"type":"paragraph","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"children":[{"type":"text","value":"To make sure our plots retain their interactivity, set the following line at the top of your notebook:","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"key":"z0fjiPQr6f"}],"key":"f1YyHrQcNX"},{"type":"code","lang":"","value":"%matplotlib qt","position":{"start":{"line":95,"column":1},"end":{"line":97,"column":1}},"key":"WwdhJ8pbmv"},{"type":"paragraph","position":{"start":{"line":98,"column":1},"end":{"line":98,"column":1}},"children":[{"type":"text","value":"This will mean your figures pop out as individual, interactive plots that will allow you to explore the data, rather than as static, inline plots. You can switch “qt” to “inline” to switch back to default, inline plotting.","position":{"start":{"line":98,"column":1},"end":{"line":98,"column":1}},"key":"UAjjPtJGAM"}],"key":"MLn4HwSOuk"},{"type":"heading","depth":2,"position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"children":[{"type":"text","value":"Loading and processing data","position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"key":"gCES65Plpe"}],"identifier":"loading-and-processing-data","label":"Loading and processing data","html_id":"loading-and-processing-data","implicit":true,"key":"TGjrTSivN5"},{"type":"blockquote","position":{"start":{"line":101,"column":1},"end":{"line":101,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":101,"column":1},"end":{"line":101,"column":1}},"children":[{"type":"text","value":"NOTE: MNE has many helpful tutorials which delve into data processing and analysis using MNE-python in much further detail. These can be found ","position":{"start":{"line":101,"column":1},"end":{"line":101,"column":1}},"key":"vkzX7MUZvO"},{"type":"link","url":"https://mne.tools/stable/auto_tutorials/index.html","position":{"start":{"line":101,"column":1},"end":{"line":101,"column":1}},"children":[{"type":"text","value":"here","position":{"start":{"line":101,"column":1},"end":{"line":101,"column":1}},"key":"D3sF0JEYgY"}],"urlSource":"https://mne.tools/stable/auto_tutorials/index.html","key":"gGaAx74AuZ"}],"key":"hsq1oR4LLe"}],"key":"TKxTQEkqhk"},{"type":"paragraph","position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"children":[{"type":"text","value":"Begin by importing the necessary modules and creating a pointer to the data:","position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"key":"GlURmre7JX"}],"key":"YBL0K0bMfo"},{"type":"code","lang":"","value":"# Interactive plotting\n%matplotlib qt\n\n# Import modules\nimport os\nimport numpy as np\nimport mne\n\n# Load data\nsample_data_folder = '/neurodesktop-storage/EEGDemo/Data_sample'\nsample_data_raw_file = os.path.join(sample_data_folder, 'sub-01', 'eeg',\n                                    'sub-01_task-FeatAttnDec_eeg.vhdr')\nraw = mne.io.read_raw_brainvision(sample_data_raw_file , preload=True)","position":{"start":{"line":104,"column":1},"end":{"line":118,"column":1}},"key":"xlOI9945Ic"},{"type":"paragraph","position":{"start":{"line":120,"column":1},"end":{"line":120,"column":1}},"children":[{"type":"text","value":"the ","position":{"start":{"line":120,"column":1},"end":{"line":120,"column":1}},"key":"btlAO0MQ4K"},{"type":"link","url":"http://raw.info","position":{"start":{"line":120,"column":1},"end":{"line":120,"column":1}},"children":[{"type":"text","value":"raw.info","position":{"start":{"line":120,"column":1},"end":{"line":120,"column":1}},"key":"GyqTvQlMGw"}],"urlSource":"http://raw.info","key":"coMIdr01ec"},{"type":"text","value":" structure contains information about the dataset:","position":{"start":{"line":120,"column":1},"end":{"line":120,"column":1}},"key":"acp60JbQAk"}],"key":"IX36ulG2A1"},{"type":"code","lang":"","value":"# Display data info\nprint(raw)\nprint(raw.info)","position":{"start":{"line":121,"column":1},"end":{"line":125,"column":1}},"key":"VdFaUu68cA"},{"type":"paragraph","position":{"start":{"line":127,"column":1},"end":{"line":127,"column":1}},"children":[{"type":"text","value":"This data file did not include a montage. Lets create one using standard values for the electrodes we have:","position":{"start":{"line":127,"column":1},"end":{"line":127,"column":1}},"key":"Ro7vSgWAdy"}],"key":"bXPHw5Ci61"},{"type":"code","lang":"","value":"# Create montage\nmontage = {'Iz':  [0, -110, -40],\n            'Oz': [0, -105, -15],\n            'POz': [0,   -100, 15],\n            'O1': [-40, -106, -15],\n            'O2':  [40, -106, -15],\n }\n\nmontageuse = mne.channels.make_dig_montage(ch_pos=montage, lpa=[-82.5, -19.2, -46], nasion=[0, 83.2, -38.3], rpa=[82.2, -19.2, -46]) # based on mne help file on setting 10-20 montage","position":{"start":{"line":128,"column":1},"end":{"line":138,"column":1}},"key":"BRXONISJqY"},{"type":"paragraph","position":{"start":{"line":140,"column":1},"end":{"line":140,"column":1}},"children":[{"type":"text","value":"Next, lets visualise the data.","position":{"start":{"line":140,"column":1},"end":{"line":140,"column":1}},"key":"z6n28dFvaL"}],"key":"cND5dmzsJa"},{"type":"code","lang":"","value":"raw.plot()","position":{"start":{"line":141,"column":1},"end":{"line":143,"column":1}},"key":"NCGXsiuKcQ"},{"type":"paragraph","position":{"start":{"line":145,"column":1},"end":{"line":145,"column":1}},"children":[{"type":"text","value":"This should open an interactive window in which you can scroll through the data. See the MNE documentation for help on how to customise this plot.","position":{"start":{"line":145,"column":1},"end":{"line":145,"column":1}},"key":"kyxYfMWOE5"}],"key":"mJkyXk5dNb"},{"type":"image","url":"/edu/build/EEGtut6-c6301ad80a90369b45317ce99169c2ac.png","alt":"EEGtut6","title":"EEGtut6","position":{"start":{"line":147,"column":1},"end":{"line":147,"column":1}},"key":"Cl2s3576sV","urlSource":"/static/tutorials/electrophysiology/eeg_mne-python/EEGtut6.png"},{"type":"paragraph","position":{"start":{"line":149,"column":1},"end":{"line":149,"column":1}},"children":[{"type":"text","value":"If, upon visual inspection, you decide to exclude one of the channels, you can specify this in ","position":{"start":{"line":149,"column":1},"end":{"line":149,"column":1}},"key":"Ol8cwd4CBv"},{"type":"link","url":"http://raw.info","position":{"start":{"line":149,"column":1},"end":{"line":149,"column":1}},"children":[{"type":"text","value":"raw.info","position":{"start":{"line":149,"column":1},"end":{"line":149,"column":1}},"key":"UbJlQzcq39"}],"urlSource":"http://raw.info","key":"AjizMf8m6i"},{"type":"text","value":"[‘bads’] now. For example:","position":{"start":{"line":149,"column":1},"end":{"line":149,"column":1}},"key":"dHj0w80iuw"}],"key":"ISJsFXwwwc"},{"type":"code","lang":"","value":"raw.info['bads'] = ['POz']","position":{"start":{"line":150,"column":1},"end":{"line":152,"column":1}},"key":"APJjNV8U4U"},{"type":"paragraph","position":{"start":{"line":154,"column":1},"end":{"line":154,"column":1}},"children":[{"type":"text","value":"Next, we’ll extract our events. The trigger channel in this file is incorrectly scaled, so we’ll correct that before we extract our events:","position":{"start":{"line":154,"column":1},"end":{"line":154,"column":1}},"key":"lzlHjYtN8d"}],"key":"oYB4P7pXVW"},{"type":"code","lang":"","value":"# Correct trigger scaling\ntrigchan = raw.copy()\ntrigchan = trigchan.pick('TRIG')\ntrigchan._data = trigchan._data*1000000\n\n# Extract events\nevents = mne.find_events(trigchan, stim_channel='TRIG', consecutive=True, initial_event=True, verbose=True)\nprint('Found %s events, first five:' % len(events))\nprint(events[:5])\n\n# Plot events\nmne.viz.plot_events(events, raw.info['sfreq'], raw.first_samp)","position":{"start":{"line":155,"column":1},"end":{"line":168,"column":1}},"key":"mpD3fNPJXD"},{"type":"image","url":"/edu/build/EEGtut7-4cf9477e368ae3f7d5f790c50009698d.png","alt":"EEGtut7","title":"EEGtut7","position":{"start":{"line":170,"column":1},"end":{"line":170,"column":1}},"key":"SRKSaGZJ4D","urlSource":"/static/tutorials/electrophysiology/eeg_mne-python/EEGtut7.png"},{"type":"paragraph","position":{"start":{"line":172,"column":1},"end":{"line":172,"column":1}},"children":[{"type":"text","value":"Now that we’ve extracted our events, we can extract our EEG channels and do some simple pre-processing:","position":{"start":{"line":172,"column":1},"end":{"line":172,"column":1}},"key":"Un9ntBW3fo"}],"key":"ig0mWmDRaR"},{"type":"code","lang":"","value":"# select\neeg_data = raw.copy().pick_types(eeg=True, exclude=['TRIG'])\n\n# Set montage\neeg_data.info.set_montage(montageuse)\n\n# Interpolate\neeg_data_interp = eeg_data.copy().interpolate_bads(reset_bads=True) \n\n# Filter Data\neeg_data_interp.filter(l_freq=1, h_freq=45, h_trans_bandwidth=0.1)","position":{"start":{"line":173,"column":1},"end":{"line":185,"column":1}},"key":"Gp7MfPM1Nt"},{"type":"paragraph","position":{"start":{"line":187,"column":1},"end":{"line":187,"column":1}},"children":[{"type":"text","value":"Let’s visualise our data again now that it’s cleaner:","position":{"start":{"line":187,"column":1},"end":{"line":187,"column":1}},"key":"aVBcIHqUbA"}],"key":"kxmsyZhmjP"},{"type":"code","lang":"","value":"#plot results again, this time with some events and scaling. \neeg_data_interp.plot(events=events, duration=10.0, scalings=dict(eeg=0.00005), color='k', event_color='r')","position":{"start":{"line":188,"column":1},"end":{"line":191,"column":1}},"key":"Auly6D9YjS"},{"type":"image","url":"/edu/build/EEGtut8-d8c1d30a815137b30fa0473542577476.png","alt":"EEGtut8","title":"EEGtut8","position":{"start":{"line":193,"column":1},"end":{"line":193,"column":1}},"key":"GEE0raxmFv","urlSource":"/static/tutorials/electrophysiology/eeg_mne-python/EEGtut8.png"},{"type":"paragraph","position":{"start":{"line":195,"column":1},"end":{"line":195,"column":1}},"children":[{"type":"text","value":"That’s looking good! We can even see hints of the frequency tagging. It’s about time to epoch our data.","position":{"start":{"line":195,"column":1},"end":{"line":195,"column":1}},"key":"mVIg8CsT9d"}],"key":"o9lnaXoD2B"},{"type":"code","lang":"","value":"# Epoch to events of interest\nevent_id = {'attend 6Hz K': 23, 'attend 7.5Hz K':  27}  \n\n# Extract 15 s epochs relative to events, baseline correct, linear detrend, and reject \n# epochs where eeg amplitude is > 400\nepochs = mne.Epochs(eeg_data_interp, events, event_id=event_id, tmin=0,\n                    tmax=15, baseline=(0, 0), reject=dict(eeg=0.000400), detrend=1)  \n\n# Drop bad trials\nepochs.drop_bad()","position":{"start":{"line":196,"column":1},"end":{"line":207,"column":1}},"key":"RcKKoY5FEq"},{"type":"paragraph","position":{"start":{"line":209,"column":1},"end":{"line":209,"column":1}},"children":[{"type":"text","value":"We can average these epochs to form Event Related Potentials (ERPs):","position":{"start":{"line":209,"column":1},"end":{"line":209,"column":1}},"key":"IAIsdkFWqn"}],"key":"g4rnKjLxJd"},{"type":"code","lang":"","value":"# Average erpochs to form ERPs\nattend6 = epochs['attend 6Hz K'].average()\nattend75 = epochs['attend 7.5Hz K'].average()\n\n# Plot ERPs\nevokeds = dict(attend6=list(epochs['attend 6Hz K'].iter_evoked()),\n               attend75=list(epochs['attend 7.5Hz K'].iter_evoked()))\nmne.viz.plot_compare_evokeds(evokeds, combine='mean')","position":{"start":{"line":210,"column":1},"end":{"line":219,"column":1}},"key":"ypg7dEFrJA"},{"type":"image","url":"/edu/build/EEGtut9-e7a253975203d8b2d1623631c6f0318b.png","alt":"EEGtut9","title":"EEGtut9","position":{"start":{"line":221,"column":1},"end":{"line":221,"column":1}},"key":"VambPVl17J","urlSource":"/static/tutorials/electrophysiology/eeg_mne-python/EEGtut9.png"},{"type":"paragraph","position":{"start":{"line":223,"column":1},"end":{"line":223,"column":1}},"children":[{"type":"text","value":"In this plot, we can see that the data are frequency tagged. While these data were collected, the participant was performing an attention task in which two visual stimuli were flickering at 6 Hz and 7.5 Hz respectively. On each trial the participant was cued to monitor one of these two stimuli for brief bursts of motion. From previous research, we expect that the steady-state visual evoked potential (SSVEP) should be larger at the attended frequency than the unattended frequency. Lets check if this is true.","position":{"start":{"line":223,"column":1},"end":{"line":223,"column":1}},"key":"SN83IbwwMr"}],"key":"EQ8sM7il4a"},{"type":"paragraph","position":{"start":{"line":225,"column":1},"end":{"line":225,"column":1}},"children":[{"type":"text","value":"We’ll begin by exporting our epoched EEG data to a numpy array","position":{"start":{"line":225,"column":1},"end":{"line":225,"column":1}},"key":"y4yDxAql8N"}],"key":"fgkyiksj4o"},{"type":"code","lang":"","value":"# Preallocate\nn_samples = attend6.data.shape[1]\nsampling_freq = 1200 # sampling frequency\nepochs_np = np.empty((n_samples, 2) )\n\n# Get data - averaging across EEG channels\nepochs_np[:,0] = attend6.data.mean(axis=0)\nepochs_np[:,1] = attend75.data.mean(axis=0)\n","position":{"start":{"line":227,"column":1},"end":{"line":237,"column":1}},"key":"LfndigBvNX"},{"type":"paragraph","position":{"start":{"line":239,"column":1},"end":{"line":239,"column":1}},"children":[{"type":"text","value":"Next, we can use a Fast Fourier Transform (FFT) to transform the data from the time domain to the frequency domain. For this, we’ll need to import the FFT packages from scipy:","position":{"start":{"line":239,"column":1},"end":{"line":239,"column":1}},"key":"NLQohQdAbg"}],"key":"oFvllLTV9o"},{"type":"code","lang":"","value":"from scipy.fft import fft, fftfreq, fftshift\n\n# Get FFT\nfftdat = np.abs(fft(epochs_np, axis=0)) / n_samples\nfreq = fftfreq(n_samples, d=1 / sampling_freq)  # get frequency bins\n","position":{"start":{"line":241,"column":1},"end":{"line":248,"column":1}},"key":"tFRWvgqLiq"},{"type":"paragraph","position":{"start":{"line":250,"column":1},"end":{"line":250,"column":1}},"children":[{"type":"text","value":"Now that we have our frequency transformed data, we can plot our two conditions to assess whether attention altered the SSVEP amplitudes:","position":{"start":{"line":250,"column":1},"end":{"line":250,"column":1}},"key":"sG0i44ckKZ"}],"key":"jpxyAnh0iZ"},{"type":"code","lang":"","value":"import matplotlib.pyplot as plt\n\nfig,ax = plt.subplots(1, 1)\n\nax.plot(freq, fftdat[:,0], '-', label='attend 6Hz', color=[78 / 255, 185 / 255, 159 / 255])  \nax.plot(freq, fftdat[:,1], '-', label='attend 7.5Hz', color=[236 / 255, 85 / 255, 58 / 255])  \nax.set_xlim(4, 17)\nax.set_ylim(0, 1e-6)\nax.set_title('Frequency Spectrum')\nax.legend()\n\n","position":{"start":{"line":252,"column":1},"end":{"line":265,"column":1}},"key":"U6qN8yNPlo"},{"type":"image","url":"/edu/build/EEGtut10-fff60b4b9bc5b9616df7551cba39866a.PNG","alt":"EEGtut10","title":"EEGtut10","position":{"start":{"line":266,"column":1},"end":{"line":266,"column":1}},"key":"fKdDvUm6HJ","urlSource":"/static/tutorials/electrophysiology/eeg_mne-python/EEGtut10.PNG"},{"type":"paragraph","position":{"start":{"line":268,"column":1},"end":{"line":268,"column":1}},"children":[{"type":"text","value":"This plot shows that the SSVEPs were indeed modulated by attention in the direction we would expect! Congratulations! You’ve run your first analysis of EEG data in neurodesktop.","position":{"start":{"line":268,"column":1},"end":{"line":268,"column":1}},"key":"Ykow3OhARW"}],"key":"ElZ98q3Xbm"}],"key":"kHR2OWW1NC"}],"key":"UA1HoeZF8i"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Electrophysiology","url":"/tutorials/electrophysiology/intro","group":"Neurodesk"},"next":{"title":"Analysing M/EEG Data with FieldTrip","url":"/tutorials/electrophysiology/fieldtrip","group":"Neurodesk"}}},"domain":"http://localhost:3000"}